# ---- server (Railway) ----
PORT=4700
LIVE=0                      # 0 = DRY_RUN (compute + simulate, send nothing). 1 = real swaps + transfers.
RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=             # when set, RPC_URL is ignored and Helius is used
DATABASE_URL=               # Postgres. blank = JSON file store in DATA_DIR
DATA_DIR=./data/state
VAULT_SECRET_KEY=           # base58, 64 bytes. generated by: node scripts/gen-vault.mjs
TOKEN_MINT=                 # blank until launch
TOKEN_NAME=
TOKEN_SYMBOL=
TOKEN_SUPPLY=1000000000
TOKEN_DECIMALS=6
ELIGIBLE_BPS=10             # 0.1% of supply
EXCLUDED_WALLETS=           # comma list: LP, bonding curve, etc. vault is always excluded
ROUND_INTERVAL_HOURS=6
ROUND_JITTER_MIN=10
MIN_ROUND_POOL_SOL=0.5
FEE_RESERVE_SOL=0.05
UNIVERSE_SIZE=20
DEFAULT_BASKET_SIZE=5         # used only when DEFAULT_BASKET is blank
DEFAULT_BASKET=SPCXx:100      # what a holder who never picks receives. TICKER:PCT, totalling 100.
                              # blank = the top DEFAULT_BASKET_SIZE, split evenly.
                              # every extra stock here costs ~0.002137 SOL of rent PER HOLDER,
                              # paid by the project, once per holder per stock.
LIQ_MIN_USD=50000
SLIPPAGE_BPS=100
PRIORITY_FEE_LAMPORTS=200000
ADMIN_KEY=                  # X-Admin-Key header for /api/admin/*
SESSION_SECRET=             # HMAC secret for session tokens
CORS_ORIGIN=*
JUP_BASE=https://lite-api.jup.ag
